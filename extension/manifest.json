{
  "manifest_version": 3,
  "name": "Redact",
  "version": "0.1.0",
  "description": "Check ChatGPT drafts for sensitive information before you send.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Redact",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "scanner.js",
        "model.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
